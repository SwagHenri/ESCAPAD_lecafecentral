diff --git a/js/consent.js b/js/consent.js
new file mode 100644
index 0000000..7a9af70
--- /dev/null
+++ b/js/consent.js
@@ -0,0 +1,73 @@
+/* Café Central — bandeau cookies + Consent Mode v2 (mise à jour du consentement).
+   Modèle OPT-OUT (décision ESCAPAD) : le consentement est accordé par défaut et n'est retiré que si
+   l'utilisateur clique « Continuer sans accepter ». Les valeurs PAR DÉFAUT du Consent Mode sont posées
+   inline dans <head>, avant GTM, sur chaque page (constante OPT_IN=false).
+   Ce fichier : affiche le bandeau sur toutes les pages, mémorise le choix (localStorage « cc-cookie-consent »)
+   et envoie gtag('consent','update') + l'événement dataLayer cc_consent_update.
+   API : ccConsent.get() → 'accepted' | 'refused' | null · ccConsent.set('accepted'|'refused') · ccConsent.reset() (réaffiche le bandeau). */
+(function () {
+  'use strict';
+  var KEY = 'cc-cookie-consent';
+  var PRIVACY_URL = 'https://www.escapad.fr/confidentialite';
+  var banner = null;
+
+  function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
+  function store(choice) { try { localStorage.setItem(KEY, choice); } catch (e) {} }
+  function push() { window.dataLayer = window.dataLayer || []; window.dataLayer.push(arguments); }
+
+  function apply(choice) {
+    var g = choice === 'accepted' ? 'granted' : 'denied';
+    push('consent', 'update', { ad_storage: g, ad_user_data: g, ad_personalization: g, analytics_storage: g });
+    push('set', 'ads_data_redaction', g === 'denied');
+    window.dataLayer.push({ event: 'cc_consent_update', consent_choice: choice });
+  }
+
+  function build() {
+    if (banner) return banner;
+    var style = document.createElement('style');
+    style.textContent =
+      '#cookie-banner{position:fixed;left:16px;right:16px;bottom:16px;z-index:70;max-width:560px;margin:0 auto;background:rgba(44,101,56,0.96);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);color:#FFF4C9;border:1px solid rgba(255,244,201,0.2);border-radius:18px;padding:22px 24px;box-shadow:0 20px 60px rgba(0,0,0,0.45);font-family:"Archivo",sans-serif}' +
+      '#cookie-banner h2{margin:0 0 8px;font-size:16px;font-weight:900;font-style:italic;text-transform:uppercase;letter-spacing:0.02em}' +
+      '#cookie-banner p{margin:0;font-size:13.5px;line-height:1.6;color:rgba(255,244,201,0.8)}' +
+      '#cookie-banner p a{color:#FFF4C9}' +
+      '.cookie-actions{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}' +
+      '.cookie-btn{flex:1;min-width:150px;font-family:inherit;font-size:13px;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;padding:12px 18px;border-radius:999px;cursor:pointer;transition:background .15s,border-color .15s}' +
+      '.cookie-accept{background:#BA4E2E;color:#FFF4C9;border:none}.cookie-accept:hover{background:#9E3F22}' +
+      '.cookie-refuse{background:none;color:#FFF4C9;border:1.5px solid rgba(255,244,201,0.4)}.cookie-refuse:hover{border-color:#FFF4C9}';
+    document.head.appendChild(style);
+
+    banner = document.createElement('div');
+    banner.id = 'cookie-banner';
+    banner.setAttribute('role', 'dialog');
+    banner.setAttribute('aria-label', 'Gestion des cookies');
+    banner.setAttribute('aria-live', 'polite');
+    banner.style.display = 'none';
+    banner.innerHTML =
+      '<h2>Cookies &amp; mesure d’audience</h2>' +
+      '<p>Nous utilisons Google Analytics pour mesurer l’audience du site et Google Ads pour mesurer nos campagnes. ' +
+      'Vous pouvez refuser : le site fonctionne exactement pareil. ' +
+      '<a href="' + PRIVACY_URL + '" target="_blank" rel="noopener">En savoir plus</a></p>' +
+      '<div class="cookie-actions">' +
+      '<button type="button" id="cookie-refuse" class="cookie-btn cookie-refuse">Continuer sans accepter</button>' +
+      '<button type="button" id="cookie-accept" class="cookie-btn cookie-accept">Tout accepter</button>' +
+      '</div>';
+    banner.querySelector('#cookie-accept').addEventListener('click', function () { decide('accepted'); });
+    banner.querySelector('#cookie-refuse').addEventListener('click', function () { decide('refused'); });
+    document.body.appendChild(banner);
+    return banner;
+  }
+
+  function show() { build().style.display = 'block'; }
+  function hide() { if (banner) banner.style.display = 'none'; }
+  function decide(choice) { store(choice); apply(choice); hide(); }
+
+  window.ccConsent = {
+    get: read,
+    set: decide,
+    reset: function () { try { localStorage.removeItem(KEY); } catch (e) {} show(); }
+  };
+
+  var stored = read();
+  if (stored === 'accepted' || stored === 'refused') return; // choix déjà exprimé sur cet appareil
+  if (document.body) show(); else document.addEventListener('DOMContentLoaded', show);
+})();
